-- средняя цена товаров для каждой категории
CREATE TABLE AveragePrices (
    CategoryID INT,
    AveragePrice DECIMAL(10, 2)
);

INSERT INTO AveragePrices (CategoryID, AveragePrice)
SELECT CategoryID, AVG(Price) AS AveragePrice
FROM Products
GROUP BY CategoryID;

